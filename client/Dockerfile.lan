# The client for the LAN watch party (docs: LAN watch party): a production build, server-rendered by Node behind
# Caddy. Nitro's node-server preset replaces the default Cloudflare target.
FROM node:22.12-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN NITRO_PRESET=node-server npm run build

FROM node:22.12-slim
WORKDIR /app
COPY --from=build /app/.output ./.output
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
USER node
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
