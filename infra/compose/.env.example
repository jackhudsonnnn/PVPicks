# Local settings for the dev stack (docker compose, from the repository root).
#
# `./scripts/provision-dev.sh --init` copies this file to `.env` (git-ignored, owner-only) with a random database
# password, and also creates `.env.auth` (session signing key) and `.env.idempotency` (retry-fingerprint key).
# Never commit `.env` or those key files. Everything below the first section is optional: the defaults shown
# are what you get without the line.

# --- Required ---------------------------------------------------------------------------------------------
# Password for the local PostgreSQL user `p2picks` (any value; `--init` generates one).
PVPICKS_DB_PASSWORD=

# --- Sports data (optional) -------------------------------------------------------------------------------
# BallDontLie API key. Without it there are no real games: the ticker says live scores are unavailable, and the
# demo's looping DEV games still run.
PVPICKS_BALLDONTLIE_API_KEY=
# Request budget. The defaults fit 5 requests a minute (free tier, GOAT trial); the docs' Player stats page has
# the All-Star values.
# PVPICKS_SPORTS_POLL_INTERVAL=PT60S
# PVPICKS_SPORTS_STATS_INTERVAL=PT20S
# PVPICKS_SPORTS_PLAYERS_INTERVAL=PT10M

# --- Ports (optional; all published on 127.0.0.1 only) ----------------------------------------------------
# The backend, which also serves the docs at /docs/.
# PVPICKS_PORT=8080
# The app (the client's dev server).
# PVPICKS_CLIENT_PORT=5173
# PostgreSQL, for a local client such as pgAdmin.
# PVPICKS_DB_PORT=5433
# Kafka UI, with `--profile tools`.
# PVPICKS_KAFKA_UI_PORT=8081
# The browser origin the backend accepts; defaults to the app's address. Set it only if you open the app from a
# different origin.
# PVPICKS_DEV_ORIGIN=http://127.0.0.1:5173

# --- Background workers (optional) ------------------------------------------------------------------------
# PVPICKS_BET_LOCK_WORKER_ENABLED=true
# PVPICKS_OUTBOX_RELAY_ENABLED=true
# PVPICKS_OUTBOX_CLEANUP_ENABLED=true
# PVPICKS_OUTBOX_RETENTION=P7D
